# Public configuration examples only. Never commit credentials.

# FastAPI runtime
ABRAIN_ENV=development
ABRAIN_HOST=127.0.0.1
ABRAIN_PORT=8000
ABRAIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3125,http://127.0.0.1:3125

# Local-first Sibyl Memory provider (no credentials required).
ABRAIN_MEMORY_ENABLED=true
ABRAIN_SIBYL_DB_PATH=.data/abrain-memory.sqlite3

# Next.js browser client
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional structured memory extraction. Leave disabled for a no-provider local build.
ABRAIN_MODEL_PROVIDER=disabled
ABRAIN_GEMINI_API_KEY=
ABRAIN_GEMINI_MODEL=gemini-3.5-flash-lite
ABRAIN_MODEL_TIMEOUT_SECONDS=20

# Agent Runner. The local runner is credential-free; Gemini is a real structured-output option.
ABRAIN_AGENT_PROVIDER=local
