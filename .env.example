# A-Brain backend configuration.
# Copy this file to `.env` in the repository root. `.env` is ignored by Git.
# Never commit real credentials.
#
# The frontend has a separate public-only template:
#   cp frontend/.env.example frontend/.env.local

# Required local runtime settings
ABRAIN_ENV=development
ABRAIN_HOST=127.0.0.1
ABRAIN_PORT=8000
ABRAIN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3125,http://127.0.0.1:3125

# Required for the real local Sibyl Memory path. Sibyl local mode needs no API key.
ABRAIN_MEMORY_ENABLED=true
ABRAIN_SIBYL_DB_PATH=.data/abrain-memory.sqlite3

# Structured memory extraction provider:
# - `disabled`: conversation remains transient unless the user writes memory manually.
# - `gemini`: Gemini extracts typed memory candidates from arbitrary conversation.
ABRAIN_MODEL_PROVIDER=disabled

# Agent response/task provider:
# - `local`: deterministic, credential-free runner.
# - `gemini`: real structured model response using scoped Sibyl records.
ABRAIN_AGENT_PROVIDER=local

# Required only when either provider above is set to `gemini`.
ABRAIN_GEMINI_API_KEY=
ABRAIN_GEMINI_MODEL=gemini-3.5-flash-lite
ABRAIN_MODEL_TIMEOUT_SECONDS=20

# Optional verification-script overrides. These do not change the application runtime.
ABRAIN_VERIFY_FRONTEND_URL=http://127.0.0.1:3125/
ABRAIN_VERIFY_HEALTH_URL=http://127.0.0.1:8000/api/health
