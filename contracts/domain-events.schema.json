{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abrain.invalid/contracts/domain-events.schema.json",
  "title": "A-Brain domain event",
  "description": "Backend-owned event envelope consumed by the world shell.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "occurred_at", "source", "correlation_id", "payload"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "enum": [
        "system.ready",
        "system.heartbeat",
        "owner.created",
        "npc.created",
        "npc.customized",
        "conversation.turn_recorded",
        "memory.extraction_failed",
        "memory.candidate_detected",
        "memory.candidate_promoted",
        "memory.candidate_rejected",
        "memory.updated",
        "memory.archived",
        "memory.deleted",
        "memory.candidate_created",
        "memory.candidate_confirmed",
        "memory.candidate_undone",
        "memory.write_requested",
        "memory.write_succeeded",
        "memory.write_failed",
        "memory.object_materialized",
        "npc.session_started",
        "npc.session_restarted",
        "npc.session_terminated",
        "memory.recall_requested",
        "memory.recall_succeeded",
        "memory.recall_failed",
        "continuity.memory_disabled",
        "behavior.changed_by_memory",
        "task.created",
        "task.started",
        "task.step_changed",
        "task.blocked",
        "task.completed",
        "handoff.created",
        "handoff.accepted",
        "handoff.started",
        "handoff.completed",
        "handoff.blocked",
        "agent.run_failed",
        "causal.replay_requested",
        "causal.replay_completed",
        "continuity.failed",
        "conversation.completed"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "proof_ref": { "type": ["string", "null"] },
    "payload": { "type": "object", "additionalProperties": true }
  }
}
