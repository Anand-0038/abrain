# A-Brain frontend configuration.
# Copy to `frontend/.env.local`. Every NEXT_PUBLIC_* value is shipped to the browser.
# Never put API keys, private tokens, or other secrets in this file.

# Must match the FastAPI host/port and an origin allowed by ABRAIN_CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional public proof identity shown in evidence captures.
# Set this to the current short Git SHA before the final build, for example: c155fb3
NEXT_PUBLIC_BUILD_SHA=
